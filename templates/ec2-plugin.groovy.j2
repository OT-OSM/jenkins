import hudson.model.Node
import hudson.plugins.ec2.*
import jenkins.model.Jenkins

def jenkins = Jenkins.get()

def tags = [
  new EC2Tag("Name", "{{ tags.Name }}"),
  new EC2Tag("Environment", "{{ tags.Environment }}"),
  new EC2Tag("Owner", "{{ tags.Owner }}")
]

def template = new SlaveTemplate(
  "{{ ami_id }}",
  "",
  null,
  "{{ sg_id }}",
  "",
  "{{ instance_type }}",
  true,
  "{{ label }}",
  Node.Mode.NORMAL,
  "{{ template_description }}",
  "",
  "",
  """#!/bin/bash
set -e

echo "===== Update system ====="
apt-get update -y || apt-get update -y --fix-missing

echo "===== Install SSH server ====="
apt-get install -y openssh-server

echo "===== Enable & start SSH ====="
systemctl enable ssh
systemctl restart ssh

echo "===== Install Java ====="
apt-get install -y openjdk-17-jdk

echo "===== SSH status ====="
systemctl status ssh || true
ss -lntp | grep :22 || true
""",
  "{{ executors }}",
  "{{ remote_admin }}",
  new UnixData(null, null, null, null, null),
  "java",
  "",
  false,
  "{{ subnet_id }}",
  tags,
  "{{ idle_termination_timeout }}",
  {{ minimum_instances }},
  {{ minimum_spare }},
  "{{ instance_cap }}",
  "{{ iam_instance_profile }}",
  true,
  false,
  "",
  AssociateIPStrategy.PRIVATE_IP,
  "",
  false,
  false,
  false,
  ConnectionStrategy.PRIVATE_IP,
  -1,
  [],
  HostKeyVerificationStrategyEnum.CHECK_NEW_HARD,
  Tenancy.Default,
  EbsEncryptRootVolume.DEFAULT,
  true,
  true,
  1,
  true,
  false
)

def cloud = new AmazonEC2Cloud(
  "{{ cloud_name }}",
  true,
  "",
  "{{ region }}",
  "",
  "{{ instance_cap }}",
  [template],
  "",
  ""
)

jenkins.clouds.removeAll { it.name == "{{ cloud_name }}" }
jenkins.clouds.add(cloud)
jenkins.save()

println("✅ EC2 cloud {{ cloud_name }} configured successfully")
