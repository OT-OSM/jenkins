import hudson.model.Node
import hudson.plugins.ec2.*
import jenkins.model.Jenkins

def jenkins = Jenkins.get()

def tags = [
{% for k,v in tags.items() %}
  new EC2Tag("{{ k }}", "{{ v }}"),
{% endfor %}
]

def template = new SlaveTemplate(
  "{{ ami_id }}",                       // AMI
  "",                                   // availabilityZone
  null,                                 // spotConfig
  "{{ security_group_id }}",            // security group
  "/home/{{ remote_admin }}",           // remoteFS
  "{{ instance_type }}",                // instanceType
  true,                                 // ebsOptimized
  "{{ label }}",                        // label
  Node.Mode.NORMAL,                     // mode
  "{{ template_description }}",         // description
  "",                                   // initScript
  "",                                   // tmpDir
  """#!/bin/bash
apt-get update -y
apt-get install -y openssh-server openjdk-17-jdk
systemctl enable ssh
systemctl start ssh
""",
  "{{ executors }}",                    // numExecutors
  "{{ remote_admin }}",                 // remoteUser
  new UnixData("/home/{{ remote_admin }}", null, null, null, null),
  "java",                               // javaPath
  "",                                   // jvmOptions
  false,                                // stopOnTerminate
  "{{ subnet_id }}",                    // subnetId
  tags,
  "{{ idle_termination_timeout }}",    // idleTerminationMinutes
  {{ minimum_instances }},
  {{ minimum_spare }},
  "{{ instance_cap }}",
  "{{ iam_instance_profile_arn }}",    // ✅ MUST be ARN
  true,
  false,
  "",
  AssociateIPStrategy.PRIVATE_IP,
  "",
  false,
  false,
  false,
  ConnectionStrategy.PRIVATE_IP,
  -1,
  [],
  HostKeyVerificationStrategyEnum.ACCEPT_NEW,
  Tenancy.Default,
  EbsEncryptRootVolume.DEFAULT,
  true,
  true,
  1,
  true,
  false
)

def cloud = new AmazonEC2Cloud(
  "{{ cloud_name }}",
  true,
  "",
  "{{ region }}",
  "",
  "{{ instance_cap }}",
  [template],
  "",
  ""
)

jenkins.clouds.removeAll { it.name == "{{ cloud_name }}" }
jenkins.clouds.add(cloud)
jenkins.save()

println("✅ EC2 cloud {{ cloud_name }} configured successfully")
